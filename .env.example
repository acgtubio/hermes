# Local development defaults, read by Taskfile.yml (and passed on to compose.yaml).
# To change any of them, copy this file to .env and edit it there: values in .env, or already in
# your shell environment, take precedence over this file. .env is git-ignored.

# Backing services (compose.yaml). If you change a port or credential here, change the matching
# URL or key in the API section too.
HERMES_PG_USER=
HERMES_PG_PASSWORD=
HERMES_PG_DB=
HERMES_PG_PORT=
HERMES_S3_PORT=

# API (hermes-web/cmd/api). Every HERMES_* setting is listed in README.md.
HERMES_DATABASE_URL=
HERMES_S3_ENDPOINT=
HERMES_S3_ACCESS_KEY=
HERMES_S3_SECRET_KEY=
HERMES_PIPELINE_URL=

# OCR sidecar (hermes-cv/server.py)
HERMES_PIPELINE_PORT=
